{
  "name": "ai-tadpole-os",
  "private": true,
  "version": "1.1.172",
  "keywords": [
    "react",
    "rust",
    "typescript",
    "mcp",
    "self-hosted",
    "autonomous-agents",
    "ai-safety",
    "swarm-intelligence",
    "ai-agents",
    "moonshots",
    "mythos",
    "local-first",
    "spud",
    "ai-agents-automation",
    "swarm-intelligence-multi-agent-llm-automation",
    "autonomous-agents-system"
  ],
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "engine": "cargo run --manifest-path server-rs/Cargo.toml",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:icon": "tauri icon",
    "graph": "cargo run --manifest-path server-rs/Cargo.toml --bin graph_query --",
    "graph:export": "cargo run --manifest-path server-rs/Cargo.toml --bin graph_query -- export --out reports/intelligence/symbol_graph.json --pretty",
    "graph:audit": "cargo run --manifest-path server-rs/Cargo.toml --bin graph_query -- audit-context --out reports/intelligence/audit_context.json --limit 25",
    "graph:lookup": "cargo run --manifest-path server-rs/Cargo.toml --bin graph_query -- lookup",
    "graph:file": "cargo run --manifest-path server-rs/Cargo.toml --bin graph_query -- file",
    "graph:blast": "cargo run --manifest-path server-rs/Cargo.toml --bin graph_query -- blast",
    "preaudit:observability": "npm run graph:audit --silent",
    "build:linux:light": "powershell -ExecutionPolicy Bypass -File scripts/build-linux-light.ps1",
    "build:linux:upload": "powershell -ExecutionPolicy Bypass -File scripts/build-linux-light.ps1 -Upload",
    "deploy:legacy-node.tadpole.local": "powershell -ExecutionPolicy Bypass -File scripts/deploy-linuxlite.ps1",
    "audit:observability": "node scripts/verify_observability_sync.cjs",
    "audit:observability:raw": "node scripts/verify_observability_sync.cjs",
    "audit:graph": "node scripts/audit_with_graph.cjs",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@types/dagre": "^0.7.54",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.17.0",
    "reactflow": "^11.11.4",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.2",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.8",
    "esbuild": "^0.25.0"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "@types/react": "$@types/react",
    "@types/react-dom": "$@types/react-dom",
    "vite": "$vite",
    "vite-plugin-pwa": {
      "vite": "$vite"
    },
    "serialize-javascript": "^7.0.4",
    "esbuild": "^0.25.0",
    "protobufjs": "^8.0.2",
    "@babel/plugin-transform-modules-systemjs": "7.29.4",
    "fast-uri": "3.1.2"
  }
}
