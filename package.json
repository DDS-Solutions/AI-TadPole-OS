{
  "name": "ai-tadpole-os",
  "private": true,
  "version": "1.1.462",
  "keywords": [
    "react",
    "rust",
    "typescript",
    "mcp",
    "self-hosted",
    "autonomous-agents",
    "ai-safety",
    "swarm-intelligence",
    "ai-agents",
    "moonshots",
    "mythos",
    "local-first",
    "spud",
    "ai-agents-automation",
    "swarm-intelligence-multi-agent-llm-automation",
    "autonomous-agents-system"
  ],
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "version:bump": "node scripts/bump_version.cjs",
    "version:check": "node scripts/bump_version.cjs --check",
    "version:test": "node scripts/version_governance.node-tests.cjs",
    "changelog:check": "node scripts/check_changelog.cjs --check",
    "startup:report": "python execution/generate_startup_report.py",
    "dev": "npx vite",
    "engine": "cargo run --manifest-path server-rs/Cargo.toml",
    "build": "tsc -b && npx vite build",
    "lint": "npx eslint .",
    "preview": "npx vite preview",
    "test": "npx vitest run --reporter=verbose",
    "test:ci": "npx vitest run --reporter=dot",
    "test:coverage": "npx vitest run --coverage --reporter=dot",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:icon": "tauri icon",
    "graph": "cargo run --manifest-path server-rs/Cargo.toml --bin graph_query --",
    "graph:export": "cargo run --manifest-path server-rs/Cargo.toml --bin graph_query -- export --out reports/intelligence/symbol_graph.json --pretty",
    "graph:audit": "cargo run --manifest-path server-rs/Cargo.toml --bin graph_query -- audit-context --out reports/intelligence/audit_context.json --limit 25",
    "graph:lookup": "cargo run --manifest-path server-rs/Cargo.toml --bin graph_query -- lookup",
    "graph:file": "cargo run --manifest-path server-rs/Cargo.toml --bin graph_query -- file",
    "graph:blast": "cargo run --manifest-path server-rs/Cargo.toml --bin graph_query -- blast",
    "graph:blast:guard": "cargo run --manifest-path server-rs/Cargo.toml --bin graph_query -- file",
    "preaudit:observability": "npm run graph:audit --silent",
    "build:linux:light": "powershell -ExecutionPolicy Bypass -File scripts/build-linux-light.ps1",
    "build:linux:upload": "powershell -ExecutionPolicy Bypass -File scripts/build-linux-light.ps1 -Upload",
    "deploy:legacy-node.tadpole.local": "powershell -ExecutionPolicy Bypass -File scripts/deploy-linuxlite.ps1",
    "audit:python": "python execution/audit_python_scripts.py .",
    "audit:ui": "python execution/ui_quality_guard.py",
    "audit:observability": "node scripts/verify_observability_sync.cjs",
    "audit:graph": "node scripts/audit_with_graph.cjs",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@tauri-apps/api": "^2.11.1",
    "@types/dagre": "^0.7.54",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.31.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "reactflow": "^11.11.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vitepress": "^1.6.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/jszip": "^3.4.1",
    "@types/node": "^26.4.0",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.26",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "ws": "^8.21.3"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "@types/react": "$@types/react",
    "@types/react-dom": "$@types/react-dom",
    "vite": "$vite",
    "vite-plugin-pwa": {
      "vite": "$vite"
    },
    "esbuild": "^0.28.2",
    "brace-expansion": "^5.0.9",
    "postcss": "^8.5.26",
    "react-router": "8.3.0",
    "nanoid": "^3.3.17"
  }
}
