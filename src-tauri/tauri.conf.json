{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI-Tadpole-OS",
  "version": "1.1.396",
  "identifier": "com.tadpole.os",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI-Tadpole-OS",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://localhost:8000 ws://localhost:8000 http://localhost:5173 ws://localhost:5173; img-src 'self' data: blob:;",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/server-rs"
    ],
    "resources": [
      "../docs/**/*",
      "../directives/**/*",
      "../src/data/knowledge/**/*",
      "../data/agents.json",
      "../data/governance_settings.json",
      "../data/infra_models.json",
      "../data/infra_providers.json",
      "../data/routines.json",
      "../data/workflows/**/*",
      "../.agent/**/*",
      "../.env.schema",
      "../.env.example"
    ]
  }
}
